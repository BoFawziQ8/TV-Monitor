<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.tvmonitor.popup"
    android:versionCode="3" android:versionName="1.2">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application android:label="TV Monitor Helper" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".PopupActivity" android:exported="true" android:permission="android.permission.DUMP"
            android:launchMode="singleTop" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar.TranslucentDecor"/>
        <service android:name=".TalkService" android:exported="true" android:permission="android.permission.DUMP"
            android:foregroundServiceType="mediaPlayback"/>
        <activity android:name=".CaptureActivity" android:exported="true" android:permission="android.permission.DUMP"
            android:excludeFromRecents="true" android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar.TranslucentDecor"/>
        <service android:name=".CaptureService" android:exported="true" android:permission="android.permission.DUMP"
            android:foregroundServiceType="mediaProjection"/>
    </application>
</manifest>
